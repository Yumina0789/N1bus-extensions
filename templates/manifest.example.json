{
  "schema": 1,
  "id": "myext",
  "name": "我的模块",
  "version": "1.0.0",
  "summary": "一句话说明它是干什么的（商店列表里显示这一句）",
  "icon": "key",
  "homepage": "https://github.com/Yumina0789/myext",

  "compose": {
    "file": "compose.yml",
    "project": "n1bus-myext",
    "services": ["app"]
  },

  "ports": [
    {"port": 9000, "proto": "tcp", "expose": false, "note": "只给本体读的 API"}
  ],

  "api": {
    "upstream": "http://127.0.0.1:9000",
    "writes": {
      "restart_service": ["/api/service", ["action"]]
    }
  },

  "page": {
    "kind": "declared",
    "title": "我的模块",
    "sections": [
      {"type": "status", "label": "服务状态"},
      {"type": "actions", "items": ["module.start", "module.stop", "module.restart"]},
      {"type": "kv", "label": "概况", "from": "summary"},
      {"type": "table", "label": "明细", "from": "items"},
      {"type": "log", "label": "日志",
       "source": {"kind": "container-log", "container": "n1bus-myext-app", "tail": 200}}
    ]
  }
}
