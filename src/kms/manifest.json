{
  "schema": 1,
  "id": "kms",
  "name": "KMS 激活服务",
  "version": "1.0.0",
  "summary": "rs-c4d：KMS wire 协议服务端（v4/v5/v6），一个静态二进制",
  "icon": "key",
  "homepage": "https://github.com/Yumina0789/RSC4D",

  "compose": {
    "file": "compose.yml",
    "project": "n1bus-kms",
    "services": ["rsc4d"]
  },

  "ports": [
    {"port": 1688, "proto": "tcp", "expose": true,
     "note": "KMS 客户端（裸 TCP，不经反代，且 docker-proxy 绕过 ufw）"}
  ],

  "page": {
    "kind": "declared",
    "title": "KMS",
    "sections": [
      {"type": "actions",
       "items": ["module.start", "module.stop", "module.restart"]},

      {"type": "aggregate",
       "label": "激活统计",
       "source": {"kind": "container-log", "container": "n1bus-kms-rsc4d", "tail": 5000},
       "pattern": "^\\[(?P<ip>\\[[0-9a-fA-F:]+\\]|(?:\\d{1,3}\\.){3}\\d{1,3}):\\d+\\] KMS (?P<ver>v\\d) KMSID=(?P<kmsid>\\[[^\\]]*\\]) CMID=(?P<cmid>\\[[^\\]]*\\]) Count=(?P<count>\\d+) 产品=(?P<product>.+?) → 响应 (?P<bytes>\\d+) 字节",
       "rows": [
         {"label": "激活请求", "agg": "count"},
         {"label": "来源", "agg": "distinct", "field": "ip"},
         {"label": "命中产品", "agg": "group", "field": "product", "top": 5}
       ]},

      {"type": "log",
       "label": "最近请求",
       "source": {"kind": "container-log", "container": "n1bus-kms-rsc4d", "tail": 200}}
    ]
  }
}
